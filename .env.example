# Copy to .env and fill in. Never commit the real file.

# Required. Generate with:  openssl rand -hex 32
# The same value goes into the app under You -> Settings -> Server -> Token.
UBERMENSCH_TOKEN=

# Which model answers. One of: anthropic, claude-code, openai, ollama, echo.
# Start with echo to prove the app reaches the server, then switch.
UBERMENSCH_PROVIDER=echo

# Model name; empty = the provider's default
# (anthropic: claude-opus-5-5, openai: gpt-5.1, ollama: llama3.1:8b,
# claude-code: the account's default).
UBERMENSCH_MODEL=

# Reasoning depth where the model has one: low | medium | high (| max on Anthropic).
UBERMENSCH_EFFORT=high
UBERMENSCH_MAX_TOKENS=4096
# Seconds a single answer may take. Keep it under the app's own 170 s.
UBERMENSCH_TIMEOUT=160

# --- provider credentials: only the one you use ---------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible server: LM Studio http://host.docker.internal:1234/v1,
# OpenRouter https://openrouter.ai/api/v1, ...
OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama on the host (default), or http://ollama:11434 with the compose profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# claude-code: how to invoke Claude Code inside the container.
CLAUDE_CODE_CMD=claude

# --- host side -------------------------------------------------------------
# Address to publish on. 127.0.0.1 = this machine only (put a TLS proxy in
# front); a LAN or VPN address to reach it from the phone directly.
BIND_ADDR=127.0.0.1
PORT=8099
# Where the SQLite history and the Claude Code login live on the host.
STATE_ROOT=./state
CLAUDE_CODE_DIR=./claude
# Serving under a prefix behind a reverse proxy, e.g. /ubermensch; empty otherwise.
UBERMENSCH_ROOT_PATH=
